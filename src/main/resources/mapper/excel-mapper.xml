<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="excel">

    <delete id="clearDataTable">
        delete
        from data
        where 1 == 1;
    </delete>

    <insert id="newDataTable" parameterType="excel">
        insert into data (insert_no,
                          part_code,
                          rev,
                          apply_1,
                          apply_2,
                          blueprint_date,
                          client_blueprint,
                          scan,
                          blueprint,
                          category,
                          name,
                          spec,
                          maker,
                          vendor,
                          unit_price,
                          mgmt_cost,
                          est_price,
                          ref_price,
                          note)
        values (#{insertNo},
                #{partCode},
                #{rev},
                #{apply1},
                #{apply2},
                #{blueprintDate},
                #{clientBlueprint},
                #{scan},
                #{blueprint},
                #{category},
                #{name},
                #{spec},
                #{maker},
                #{vendor},
                #{unitPrice},
                #{mgmtCost},
                #{estPrice},
                #{refPrice},
                #{note})
    </insert>
    <delete id="clearHierarchyTable">
        delete
        from hierarchy
        where 1 == 1;
    </delete>

    <insert id="newHierarchyTable" parameterType="hierarchy">
        insert into hierarchy (parent_no, child_no)
        values (#{parent_no}, #{child_no})
    </insert>

</mapper>
