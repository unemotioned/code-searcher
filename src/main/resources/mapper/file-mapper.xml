<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="filePath">

    <insert id="insertPath" parameterType="com.mcs.modelsearcher.file.model.vo.FilePath">
        INSERT INTO FILE (file_path)
        VALUES (#{filePath})
    </insert>

</mapper>
