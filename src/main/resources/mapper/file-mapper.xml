<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="filePath">

    <select id="selectPath" resultType="string">
        SELECT file_path
        FROM file LIMIT 1;
    </select>

    <delete id="deleteInvalidPath">
        DELETE FROM file
    </delete>

    <insert id="insertPath" parameterType="filePath">
        INSERT INTO file (file_path)
        VALUES (#{filePath})
    </insert>

</mapper>
